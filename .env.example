# ContentX environment template
# Copy to .env for local use. Never commit real passwords, tokens or cloud credentials.

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=debug
SERVER_BASE_URL=http://localhost:8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=120s

# Docker Compose published ports
APP_PORT=8080
HTTP_PORT=80
HTTPS_PORT=443

# Database: sqlite | postgres | mysql
DB_DRIVER=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_USER=contentx
DB_PASSWORD=
DB_NAME=contentx
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CHARSET=utf8mb4
DB_TIMEZONE=Asia/Shanghai

# Authentication
# release mode requires a random JWT secret of at least 32 characters.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=contentx
AUTH_ALLOW_REGISTRATION=false

# Initial administrator
# Used only when the user table is empty. Changing this value does not reset an existing account.
ADMIN_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=contentx:
CACHE_DRIVER=memory
CACHE_DEFAULT_TTL=10m
CACHE_MAX_ENTRIES=10000

# Webhook delivery queue
QUEUE_DRIVER=memory
QUEUE_MAX_WORKERS=4
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY=5s
# Leave false in production unless private-network webhook targets are explicitly required.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# Uploads
UPLOAD_MAX_SIZE=20971520
UPLOAD_STORAGE_PATH=./uploads
UPLOAD_URL_PREFIX=/uploads
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,video/mp4
UPLOAD_THUMBNAIL_MAX=400
UPLOAD_IMAGE_QUALITY=85

# Storage: local | s3
# S3 uses minio-go/v7 and supports AWS S3-compatible endpoints.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=contentx
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
S3_USE_SSL=true
# true for MinIO and other path-style deployments; normally false for AWS S3.
S3_PATH_STYLE=false

# SMTP
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@contentx.local
SMTP_FROM_NAME=ContentX
SMTP_USE_TLS=true

# Search: builtin | noop
# External search settings are reserved; current production code falls back to builtin.
SEARCH_ENGINE=builtin
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=contentx
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=

# Backup
BACKUP_DIR=./backups
BACKUP_MAX=10
BACKUP_COMPRESS=gzip
BACKUP_SCHEDULE=0 3 * * *

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION=90
ANALYTICS_SAMPLE_RATE=1.0

# Limits
LIMITS_API_RATE=300
LIMITS_UPLOAD_RATE=10
LIMITS_MAX_PAGE_SIZE=100
LIMITS_DEFAULT_PAGE_SIZE=20
LIMITS_MAX_COMMENT_DEPTH=5
LIMITS_MAX_MENU_DEPTH=4
LIMITS_MAX_BULK_ACTION_SIZE=100

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Authorization,Accept,X-Requested-With
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=86400

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=3
LOG_MAX_AGE=28

# Prometheus
METRICS_ENABLED=true
METRICS_PATH=/metrics

# OpenTelemetry OTLP/HTTP
OTEL_ENABLED=false
OTEL_SERVICE_NAME=contentx
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACE_SAMPLE_RATIO=1.0

# MCP
MCP_INCLUDE_DRAFTS=false
MCP_HTTP_ENABLED=false

# Plugins and themes
PLUGIN_DIR=./plugins
PLUGIN_ENABLED=
THEME_DIR=./themes
THEME_DEFAULT=default

# Locale metadata
I18N_DEFAULT_LOCALE=en
I18N_LOCALES=en

# Grafana (Docker Compose monitor profile)
GRAFANA_USER=admin
GRAFANA_PASSWORD=
