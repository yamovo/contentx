{
  "name": "@contentx/sdk",
  "version": "1.0.0",
  "description": "Official TypeScript SDK for ContentX Headless CMS",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:example": "tsc --noEmit --strict --target ES2020 --module NodeNext --moduleResolution NodeNext examples/basic.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run check:example",
    "prepack": "npm run build"
  },
  "keywords": ["cms", "headless", "contentx", "api"],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.3.3",
    "vitest": "^1.3.0"
  }
}
